PORT=3000
APP_URL=https://your-domain.example
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisNow123!
# Meta webhook verification token: choose your own random string and use the same in Meta
META_VERIFY_TOKEN=replace-with-another-random-secret
# Optional: set your Meta App Secret to validate X-Hub-Signature-256
META_APP_SECRET=
# Graph API version shown in your Meta developer dashboard. Keep this current.
META_GRAPH_VERSION=vXX.X
